{
  "rules": {
    ".read": true,
    ".write": true,
    "products": {
      ".indexOn": ["category", "brand", "price", "isBestSeller", "isNewArrival"]
    },
    "orders": {
      ".indexOn": ["customerPhone", "status", "createdAt"]
    },
    "articles": {
      ".indexOn": ["isPublished", "category", "createdAt"]
    },
    "reviews": {
      ".indexOn": ["productId", "rating", "createdAt"]
    }
  }
}
