{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists())",
      ".indexOn": ["category", "brand", "price", "isBestSeller", "isNewArrival"]
    },

    "articles": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists())",
      ".indexOn": ["isPublished", "category", "createdAt"]
    },

    "orders": {
      ".read": "auth != null && (auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists())",
      "$orderCode": {
        ".read": true,
        ".write": "!data.exists() || (auth != null && (auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['orderCode', 'customerName', 'customerPhone', 'shippingAddress', 'items', 'totalAmount'])"
      },
      ".indexOn": ["customerPhone", "status", "createdAt"]
    },

    "reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "!data.exists() || (auth != null && (data.child('userId').val() === auth.uid || auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['productId', 'userName', 'rating', 'comment'])"
      },
      ".indexOn": ["productId", "rating", "createdAt"]
    },

    "promotions": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists())"
    },

    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'matkinhsaigonone@gmail.com'"
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'matkinhsaigonone@gmail.com' || root.child('admins').child(auth.uid).exists())"
      }
    }
  }
}
