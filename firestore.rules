rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. CÔNG KHAI ĐỌC & GHI TOÀN BỘ SẢN PHẨM (Products)
    // Cho phép web đọc danh mục kính, thêm kính mới, sửa, xóa và auto-seed dữ liệu
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. CÔNG KHAI ĐỌC & GHI BÀI VIẾT / TIN TỨC (Articles)
    match /articles/{articleId} {
      allow read, write: if true;
    }

    // 3. CÔNG KHAI TẠO & TRA CỨU ĐƠN HÀNG (Orders)
    // Cho phép khách hàng đặt hàng, tra cứu tiến độ mài tròng & cập nhật trạng thái đơn
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 4. CÔNG KHAI ĐÁNH GIÁ SẢN PHẨM (Reviews)
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // 5. CÔNG KHAI MÃ KHUYẾN MÃI (Promotions)
    match /promotions/{promoId} {
      allow read, write: if true;
    }

    // 6. QUẢN TRỊ VIÊN & HỒ SƠ
    match /admins/{adminId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }

    // 7. Mở quyền toàn bộ database trong giai đoạn phát triển & vận hành web
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
